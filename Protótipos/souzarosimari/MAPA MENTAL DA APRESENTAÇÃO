import sqlite3
from datetime import datetime

def seed():
    conn = sqlite3.connect('database.db')
    c = conn.cursor()

    # Cartões de exemplo
    cartoes = [
        ("João da Silva", 20.00, "ativo", datetime.now().strftime("%Y-%m-%d %H:%M")),
        ("Maria Oliveira", 3.00, "ativo", datetime.now().strftime("%Y-%m-%d %H:%M")),
        ("Carlos Souza", 0.00, "ativo", datetime.now().strftime("%Y-%m-%d %H:%M")),
        ("Ana Costa", 15.00, "bloqueado", datetime.now().strftime("%Y-%m-%d %H:%M")),
    ]

    for cartao in cartoes:
        c.execute("INSERT INTO cartoes (nome_passageiro, saldo, status, data_criacao) VALUES (?, ?, ?, ?)", cartao)

    conn.commit()
    conn.close()
    print("Cartões de exemplo inseridos com sucesso!")

if __name__ == "__main__":
    seed()
