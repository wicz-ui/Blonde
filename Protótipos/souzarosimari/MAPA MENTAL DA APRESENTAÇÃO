import pytest
import sqlite3
from app import app, inicializar_banco, conectar, VALOR_PASSAGEM

@pytest.fixture
def client():
    inicializar_banco()
    app.config['TESTING'] = True
    with app.test_client() as client:
        yield client

def criar_cartao(nome="Teste", saldo=20.0):
    conn = conectar()
    c = conn.cursor()
    c.execute("INSERT INTO cartoes (nome_passageiro, saldo, status, data_criacao) VALUES (?, ?, ?, datetime('now'))",
              (nome, saldo, 'ativo'))
    conn.commit()
    id_cartao = c.lastrowid
    conn.close()
    return id_cartao

def test_index(client):
    resp = client.get('/')
    assert resp.status_code == 200
    assert b"Sistema de Catraca Virtual" in resp.data

def test_criar_cartao(client):
    resp = client.post('/criar-cartao', data={'nome': 'Joao', 'saldo': 15})
    assert b"Cartão criado com sucesso" in resp.data

def test_visualizar_cartao(client):
    id_cartao = criar_cartao("Maria", 30)
    resp = client.post('/cartao', data={'id': id_cartao})
    assert b"Maria" in resp.data
    assert b"30" in resp.data

def test_catraca_aprovada(client):
    id_cartao = criar_cartao("Carlos", 10)
    resp = client.post('/catraca', data={'id': id_cartao})
    assert b"Entrada aprovada" in resp.data

def test_catraca_saldo_insuficiente(client):
    id_cartao = criar_cartao("Ana", 2)
    resp = client.post('/catraca', data={'id': id_cartao})
    assert b"Saldo insuficiente" in resp.data

def test_catraca_cartao_inexistente(client):
    resp = client.post('/catraca', data={'id': 9999})
    assert b"Cartão não encontrado" in resp.data

def test_historico(client):
    id_cartao = criar_cartao("Pedro", 20)
    client.post('/catraca', data={'id': id_cartao})
    resp = client.get('/historico')
    assert b"Pedro" in resp.data
    assert b"aprovado" in resp.data or b"negado" in resp.data
