from flask import Flask, render_template, request, redirect
import sqlite3
from datetime import datetime

app = Flask(__name__)
VALOR_PASSAGEM = 5.00

def conectar():
    return sqlite3.connect('database.db')

def inicializar_banco():
    conn = conectar()
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS cartoes (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    nome_passageiro TEXT,
                    saldo REAL,
                    status TEXT,
                    data_criacao TEXT)''')
    c.execute('''CREATE TABLE IF NOT EXISTS passagens (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    cartao_id INTEGER,
                    data_hora TEXT,
                    status TEXT,
                    motivo TEXT,
                    valor_cobrado REAL)''')
    conn.commit()
    conn.close()

@app.route('/')
def index():
    return render_template('index.html')

@app.route('/criar-cartao', methods=['GET', 'POST'])
def criar_cartao():
    if request.method == 'POST':
        nome = request.form['nome']
        saldo = float(request.form['saldo'])
        data = datetime.now().strftime("%Y-%m-%d %H:%M")
        conn = conectar()
        c = conn.cursor()
        c.execute("INSERT INTO cartoes (nome_passageiro, saldo, status, data_criacao) VALUES (?, ?, ?, ?)",
                  (nome, saldo, 'ativo', data))
        conn.commit()
        id_cartao = c.lastrowid
        conn.close()
        return render_template('resultado.html', mensagem=f"Cartão criado com sucesso! ID: {id_cartao}")
    return render_template('criar_cartao.html')

@app.route('/cartao', methods=['GET', 'POST'])
def visualizar_cartao():
    if request.method == 'POST':
        id_cartao = request.form['id']
        conn = conectar()
        c = conn.cursor()
        c.execute("SELECT * FROM cartoes WHERE id=?", (id_cartao,))
        cartao = c.fetchone()
        conn.close()
        if cartao:
            return render_template('visualizar_cartao.html', cartao=cartao)
        else:
            return render_template('resultado.html', mensagem="Cartão não encontrado.")
    return render_template('visualizar_cartao.html')

@app.route('/catraca', methods=['GET', 'POST'])
def catraca():
    if request.method == 'POST':
        id_cartao = request.form['id']
        conn = conectar()
        c = conn.cursor()
        c.execute("SELECT * FROM cartoes WHERE id=?", (id_cartao,))
        cartao = c.fetchone()
        data_hora = datetime.now().strftime("%Y-%m-%d %H:%M")
        if not cartao:
            c.execute("INSERT INTO passagens (cartao_id, data_hora, status, motivo, valor_cobrado) VALUES (?, ?, ?, ?, ?)",
                      (id_cartao, data_hora, 'negado', 'Cartão não encontrado', 0))
            mensagem = "Entrada negada. Cartão não encontrado."
        elif cartao[3] != 'ativo':
            c.execute("INSERT INTO passagens (cartao_id, data_hora, status, motivo, valor_cobrado) VALUES (?, ?, ?, ?, ?)",
                      (id_cartao, data_hora, 'negado', 'Cartão bloqueado', 0))
            mensagem = "Entrada negada. Cartão bloqueado."
        elif cartao[2] < VALOR_PASSAGEM:
            c.execute("INSERT INTO passagens (cartao_id, data_hora, status, motivo, valor_cobrado) VALUES (?, ?, ?, ?, ?)",
                      (id_cartao, data_hora, 'negado', 'Saldo insuficiente', 0))
            mensagem = "Entrada negada. Saldo insuficiente."
        else:
            novo_saldo = cartao[2] - VALOR_PASSAGEM
            c.execute("UPDATE cartoes SET saldo=? WHERE id=?", (novo_saldo, id_cartao))
            c.execute("INSERT INTO passagens (cartao_id, data_hora, status, motivo, valor_cobrado) VALUES (?, ?, ?, ?, ?)",
                      (id_cartao, data_hora, 'aprovado', 'Entrada liberada', VALOR_PASSAGEM))
            mensagem = "Entrada aprovada. Boa viagem!"
        conn.commit()
        conn.close()
        return render_template('resultado.html', mensagem=mensagem)
    return render_template('catraca.html')

@app.route('/historico')
def historico():
    conn = conectar()
    c = conn.cursor()
    c.execute("SELECT p.id, c.nome_passageiro, p.data_hora, p.status, p.motivo, p.valor_cobrado FROM passagens p LEFT JOIN cartoes c ON p.cartao_id = c.id")
    registros = c.fetchall()
    conn.close()
    return render_template('historico.html', registros=registros)

if __name__ == '__main__':
    inicializar_banco()
    app.run(host='0.0.0.0', port=5000)
